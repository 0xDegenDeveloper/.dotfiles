#!/usr/bin/env bash
# Point Ghostty, tmux, Neovim, and Starship at one Catppuccin flavor.
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
FLAVORS_DIR="$CONFIG_HOME/theme/flavors"
STATE_DIR="$STATE_HOME/theme"
STARSHIP="$CONFIG_HOME/starship.toml"

flavors() {
  if [[ -d "$FLAVORS_DIR" ]]; then
    ls -1 "$FLAVORS_DIR"
  fi
}

current_name() {
  if [[ -f "$STATE_DIR/name" ]]; then
    cat "$STATE_DIR/name"
  else
    printf '%s\n' "frappe"
  fi
}

usage() {
  cat <<EOF
Usage: theme-set [flavor]

Flavors: $(flavors | tr '\n' ' ')
Current: $(current_name)

  theme-set           show current flavor
  theme-set list      list flavors
  theme-set frappe    apply a flavor
EOF
}

set_starship_palette() {
  local name="$1"
  [[ -f "$STARSHIP" ]] || return 0
  python3 - "$STARSHIP" "$name" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
name = sys.argv[2]
text = path.read_text()
new, n = re.subn(
    r"^palette = 'catppuccin_\w+'",
    f"palette = 'catppuccin_{name}'",
    text,
    count=1,
    flags=re.M,
)
if n:
    path.write_text(new)
PY
}

reload_tmux() {
  tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
}

reload_nvim() {
  command -v nvim >/dev/null 2>&1 || return 0
  local server
  while IFS= read -r server; do
    [[ -n "$server" ]] || continue
    nvim --server "$server" --remote-expr "v:lua.require('config.theme').apply()" >/dev/null 2>&1 || true
  done < <(nvim --serverlist 2>/dev/null)
}

reload_ghostty() {
  case "$(uname -s)" in
    Darwin)
      if osascript -e 'tell application "System Events" to tell process "Ghostty" to click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1' >/dev/null 2>&1; then
        return 0
      fi
      printf 'Ghostty: press cmd+shift+, to reload the config.\n' >&2
      ;;
    *)
      pkill -USR2 -x ghostty >/dev/null 2>&1 || true
      ;;
  esac
}

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  list)
    flavors
    exit 0
    ;;
esac

name="$cmd"
if [[ ! -d "$FLAVORS_DIR/$name" ]]; then
  printf 'unknown flavor: %s\n' "$name" >&2
  flavors >&2
  exit 1
fi

mkdir -p "$STATE_DIR"
ln -sfn "$FLAVORS_DIR/$name" "$STATE_DIR/current"
printf '%s\n' "$name" > "$STATE_DIR/name"

set_starship_palette "$name"
reload_tmux
reload_nvim
reload_ghostty

printf 'theme: %s\n' "$name"
