# Colors come from Catppuccin via theme-set (~/.local/state/theme/current).
theme = Catppuccin Frappe
config-file = ?~/.local/state/theme/current/ghostty.conf

background-opacity = 0.55
background-blur = 255

custom-shader = ./ghostty-shaders/cursor_blaze.glsl

font-family = "AdwaitaMono Nerd Font Mono Bold"
font-size = 14

# custom-shader = ./ghostty-shaders/in-game-crt-cursor.glsl
